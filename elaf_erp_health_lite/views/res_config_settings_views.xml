<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.elaf.health</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="95"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="ERP Health Check" string="ERP Health Check" name="elaf_erp_health_lite"
                     groups="elaf_erp_health_lite.group_health_manager">
                    <block title="Lite edition" name="elaf_hc_lite_scope_block" invisible="elaf_hc_is_pro">
                        <setting id="elaf_hc_lite_scope" string="Choose your audited module"
                                 help="The Lite edition audits one business module. Once chosen (here or by the first completed scan) it cannot be changed in Lite. ERP Health Check Pro audits every module.">
                            <field name="elaf_hc_is_pro" invisible="1"/>
                            <field name="elaf_hc_lite_scope_locked" invisible="1"/>
                            <field name="elaf_hc_lite_scope" readonly="elaf_hc_lite_scope_locked"/>
                        </setting>
                    </block>
                    <block title="Check thresholds" name="elaf_hc_thresholds">
                        <setting id="elaf_hc_stale_quote" string="Stale quotations"
                                 help="Quotations older than this number of days are reported.">
                            <field name="elaf_hc_stale_quote_days"/>
                        </setting>
                        <setting id="elaf_hc_stale_rfq" string="Stale requests for quotation"
                                 help="RFQs older than this number of days are reported.">
                            <field name="elaf_hc_stale_rfq_days"/>
                        </setting>
                        <setting id="elaf_hc_dead_stock" string="Dead stock"
                                 help="Products in stock without any completed move during this number of days are reported.">
                            <field name="elaf_hc_dead_stock_days"/>
                        </setting>
                        <setting id="elaf_hc_overdue" string="Overdue customer invoices"
                                 help="Customer invoices overdue by more than this number of days are reported.">
                            <field name="elaf_hc_overdue_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_health_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'elaf_erp_health_lite', 'bin_size': False}</field>
    </record>
</odoo>
