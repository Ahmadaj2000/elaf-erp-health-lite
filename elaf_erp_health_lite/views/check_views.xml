<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_health_check_list" model="ir.ui.view">
        <field name="name">elaf.health.check.list</field>
        <field name="model">elaf.health.check</field>
        <field name="arch" type="xml">
            <tree string="Checks" create="false" delete="false">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="scope"/>
                <field name="severity" widget="badge"
                       decoration-danger="severity in ('critical', 'high')"
                       decoration-warning="severity == 'medium'" decoration-info="severity == 'low'"/>
                <field name="weight"/>
                <field name="count_threshold"/>
                <field name="is_applicable" string="Applicable"/>
                <field name="missing_modules" optional="hide"/>
                <field name="code" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_health_check_form" model="ir.ui.view">
        <field name="name">elaf.health.check.form</field>
        <field name="model">elaf.health.check</field>
        <field name="arch" type="xml">
            <form string="Check" create="false" delete="false">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="scope"/>
                            <field name="severity"/>
                            <field name="weight"/>
                            <field name="count_threshold"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="code"/>
                            <field name="res_model"/>
                            <field name="required_modules" readonly="1"/>
                            <field name="is_applicable"/>
                            <field name="missing_modules" invisible="is_applicable"/>
                            <field name="param_key" invisible="not param_key"/>
                        </group>
                    </group>
                    <group string="What it detects">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Recommendation">
                        <field name="recommendation" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_health_check_search" model="ir.ui.view">
        <field name="name">elaf.health.check.search</field>
        <field name="model">elaf.health.check</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_scope" string="Scope" context="{'group_by': 'scope'}"/>
                    <filter name="group_severity" string="Severity" context="{'group_by': 'severity'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_health_check" model="ir.actions.act_window">
        <field name="name">Checks</field>
        <field name="res_model">elaf.health.check</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_group_scope': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No checks</p>
            <p>Checks are installed with the module. Archived checks are hidden by default.</p>
        </field>
    </record>
</odoo>
