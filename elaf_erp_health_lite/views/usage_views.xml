<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_health_usage_list" model="ir.ui.view">
        <field name="name">elaf.health.usage.list</field>
        <field name="model">elaf.health.usage</field>
        <field name="arch" type="xml">
            <list string="Lite Usage" create="false" delete="false" edit="false">
                <field name="key"/>
                <field name="used"/>
                <field name="usage_limit"/>
                <field name="bound_company_id"/>
                <field name="bound_scope"/>
                <field name="last_used_at"/>
            </list>
        </field>
    </record>

    <record id="view_health_usage_log_list" model="ir.ui.view">
        <field name="name">elaf.health.usage.log.list</field>
        <field name="model">elaf.health.usage.log</field>
        <field name="arch" type="xml">
            <list string="Lite Usage Log" create="false" delete="false" edit="false">
                <field name="at"/>
                <field name="key"/>
                <field name="event" widget="badge" decoration-success="event == 'consumed'" decoration-danger="event == 'denied'"/>
                <field name="user_id"/>
                <field name="res_model"/>
                <field name="res_id"/>
            </list>
        </field>
    </record>

    <record id="action_health_usage" model="ir.actions.act_window">
        <field name="name">Lite Usage</field>
        <field name="res_model">elaf.health.usage</field>
        <field name="view_mode">list</field>
    </record>
    <record id="action_health_usage_log" model="ir.actions.act_window">
        <field name="name">Lite Usage Log</field>
        <field name="res_model">elaf.health.usage.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
