<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_health_finding_list" model="ir.ui.view">
        <field name="name">elaf.health.finding.list</field>
        <field name="model">elaf.health.finding</field>
        <field name="arch" type="xml">
            <tree string="Findings" create="false" delete="false" edit="false"
                  decoration-muted="result == 'na'" decoration-success="result == 'pass'">
                <field name="scan_id" optional="show"/>
                <field name="scan_date" optional="hide"/>
                <field name="label" string="Check"/>
                <field name="scope"/>
                <field name="severity" widget="badge"
                       decoration-danger="severity in ('critical', 'high')"
                       decoration-warning="severity == 'medium'" decoration-info="severity == 'low'"/>
                <field name="result" widget="badge"
                       decoration-danger="result == 'fail'" decoration-success="result == 'pass'"/>
                <field name="count" sum="Total"/>
                <field name="res_model_name" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_view_records" type="object" string="View records"
                        icon="fa-external-link" invisible="result != 'fail'"/>
            </tree>
        </field>
    </record>

    <record id="view_health_finding_form" model="ir.ui.view">
        <field name="name">elaf.health.finding.form</field>
        <field name="model">elaf.health.finding</field>
        <field name="arch" type="xml">
            <form string="Finding" create="false" delete="false" edit="false">
                <header>
                    <button name="action_view_records" type="object" string="View affected records"
                            class="btn-primary" invisible="result != 'fail'"/>
                    <field name="result" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="label"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="scan_id"/>
                            <field name="scope"/>
                            <field name="severity"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="count" invisible="result == 'na'"/>
                            <field name="res_model_name" invisible="result == 'na'"/>
                            <field name="na_reason" invisible="result != 'na'"/>
                            <field name="detail" invisible="not detail"/>
                            <field name="penalty" invisible="result != 'fail'"/>
                        </group>
                    </group>
                    <group string="Recommendation" invisible="result != 'fail'">
                        <field name="advice" nolabel="1" colspan="2"/>
                    </group>
                    <group string="What this check detects">
                        <field name="about" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_health_finding_search" model="ir.ui.view">
        <field name="name">elaf.health.finding.search</field>
        <field name="model">elaf.health.finding</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="scan_id"/>
                <filter name="problems" string="Problems" domain="[('result', '=', 'fail')]"/>
                <filter name="passed" string="Passed" domain="[('result', '=', 'pass')]"/>
                <filter name="na" string="Not applicable" domain="[('result', '=', 'na')]"/>
                <separator/>
                <filter name="critical_high" string="Critical / High" domain="[('severity', 'in', ('critical', 'high'))]"/>
                <group>
                    <filter name="group_scan" string="Scan" context="{'group_by': 'scan_id'}"/>
                    <filter name="group_scope" string="Scope" context="{'group_by': 'scope'}"/>
                    <filter name="group_severity" string="Severity" context="{'group_by': 'severity'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_health_finding" model="ir.actions.act_window">
        <field name="name">Findings</field>
        <field name="res_model">elaf.health.finding</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_problems': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No findings yet</p>
            <p>Run a health scan from the dashboard to detect problems in your data.</p>
        </field>
    </record>
</odoo>
